{
  "manifest_version": 3,
  "name": "TASCO - Cho phép nhúng Zalo Web",
  "version": "1.0.0",
  "description": "Cho phép app TASCO DLK hiển thị Zalo Web trong khung chat của app (chỉ trên trình duyệt này, chỉ cho các tên miền của app).",
  "permissions": [
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://*.zalo.me/*",
    "https://*.zaloapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "zalo_frames",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://huyho711997-lgtm.github.io/*",
        "https://giam-dinh-xe-rose.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "marker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.zalo.me/*"
      ],
      "js": [
        "storage-access.js"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_start"
    }
  ]
}