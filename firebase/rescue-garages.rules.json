{
  "rules": {
    "rescue_garages": {
      ".read": "auth != null",
      "$garage": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name','lat','lon','active'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "address": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "active": { ".validate": "newData.isBoolean()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other": { ".validate": false }
      }
    }
  }
}
